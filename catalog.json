{
  "v": 1,
  "apps": [
    {
      "id": "kapsula",
      "name": "Kapsula",
      "tagline": "Остров для Windows: музыка, уведомления, буфер и зверёк",
      "color": "#F08A4B",
      "kind": "portable",
      "repo": "cxxperman/kapsula",
      "asset": "Kapsula.exe",
      "exe": "Kapsula.exe",
      "process": "Kapsula",
      "sprite": [".#.......#.", ".##.....##.", ".#########.", "###########", "##E#####E##", "##E#####E##", "###########", ".#########.", ".#.#...#.#."],
      "recommended": true
    },
    {
      "id": "aura",
      "name": "Aura",
      "tagline": "Студийная обработка голоса с микрофона",
      "color": "#4F8DF7",
      "kind": "installer",
      "repo": "cxxperman/aura-voice",
      "asset": "Aura-Setup-*.exe",
      "silent": "/S",
      "installed": "%LOCALAPPDATA%\\Programs\\aura-voice\\Aura.exe",
      "process": "Aura",
      "sprite": ["....##......", "...####....#", "..######..##", ".###########", "##E########.", "##E########.", ".###########", "..######..##", "...####....#", "....##......"],
      "recommended": true
    },
    {
      "id": "maska",
      "name": "Maska",
      "tagline": "Ваш облик и звонки для Discord",
      "color": "#8A5CF6",
      "kind": "integration",
      "marker": "%APPDATA%\\Vencord\\dist\\kapsula.txt",
      "via": "kapsula",
      "hint": "Подключается через kapsula.txt: запустите её и нажмите «Подключить». Discord при этом должен быть закрыт",
      "sprite": ["#..........#", "##........##", "############", "###E####E###", "###E####E###", "############", ".####..####.", "..##....##.."],
      "connect": "discord.connect"
    },
    {
      "id": "arkada",
      "name": "Arkada",
      "tagline": "Тема и плагин для Steam в общем стиле · бета",
      "color": "#2A8FD8",
      "kind": "bundle",
      "marker": "{steam}\\millennium\\plugins\\arkada\\plugin.json",
      "hint": "Включите плагин и тему Arkada в настройках Millennium и перезапустите Steam",
      "sprite": [".####..####.", "############", "##E######E##", "#EEE####E#E#", "##E######E##", "############", "####....####", ".##......##."],
      "repo": "cxxperman/arkada.txt",
      "asset": "arkada.zip",
      "requires": "{steam}\\millennium",
      "requiresHint": "Сначала установите Millennium для Steam (steambrew.app) и запустите Steam один раз",
      "targets": [
        {
          "from": "plugin/",
          "to": "{steam}\\millennium\\plugins\\arkada"
        },
        {
          "from": "theme/",
          "to": [
            "{steam}\\millennium\\themes\\arkada",
            "{steam}\\steamui\\skins\\arkada"
          ]
        }
      ]
    },
    {
      "id": "dock",
      "name": "Dock",
      "tagline": "Док для Windows: программы, виджеты и меню приложений",
      "color": "#30D158",
      "kind": "portable",
      "repo": "cxxperman/dock.txt",
      "asset": "Dock.exe",
      "exe": "Dock.exe",
      "process": "Dock",
      "sprite": ["....####....", "....#E##....", ".##.#E##.##.", ".##.####.##.", ".##.####.##.", "............", "############", ".##########."]
    },
    {
      "id": "smena",
      "name": "Smena",
      "tagline": "Свой Alt+Tab с живыми превью окон",
      "color": "#8A5CF6",
      "kind": "portable",
      "repo": "cxxperman/smena.txt",
      "asset": "Smena.exe",
      "exe": "Smena.exe",
      "process": "Smena",
      "sprite": ["#######.....", "#######.....", "##..........", "##.#########", "##.##E###E##", "##.##E###E##", "...#########", "...#########"]
    },
    {
      "id": "metla",
      "name": "Metla",
      "tagline": "Аккуратная уборка: временные файлы, автозапуск, программы",
      "color": "#FF9F0A",
      "kind": "portable",
      "repo": "cxxperman/metla.txt",
      "asset": "Metla.exe",
      "exe": "Metla.exe",
      "process": "Metla",
      "sprite": [".......##.", "......##..", ".....##...", "....##....", "...##.....", "..####....", ".######...", ".##E###...", "###E####..", "########..", "#.#.#.#.#.", "#.#.#.#.#."]
    }
  ]
}
